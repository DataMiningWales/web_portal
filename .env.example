# Example environment file - copy to .env and configure for your environment

# Database Configuration (Replace with your AuraDB instance details)
NEO4J_URI=neo4j+s://your-auradb-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-auradb-password

# Application Security (Change these in production!)
SECRET_KEY=your-super-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (Optional - for email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@dataminingwales.org

# Admin Configuration (Change default password!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-immediately

# Logging
LOG_LEVEL=INFO